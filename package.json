{
  "name": "@synapxlab/jstree",
  "version": "1.0.0",
  "description": "Tree component — zero dependency, TypeScript + SCSS",
  "type": "module",
  "main":   "./dist/jstree.umd.cjs",
  "module": "./dist/jstree.es.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/jstree.es.js",
      "require": "./dist/jstree.umd.cjs",
      "types":   "./dist/index.d.ts"
    },
    "./style": "./dist/style.css"
  },
  "files": [
    "dist",
    "php",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev":       "vite",
    "build":     "vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && tsc --declaration --emitDeclarationOnly --outDir dist",
    "preview":   "vite preview",
    "tsc":       "tsc --noEmit"
  },
  "keywords": ["tree", "jstree", "folder", "hierarchy", "typescript", "zero-dependency"],
  "author": "synapxLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synapxlab/jstree"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sass":       "^1.77.0",
    "typescript": "^5.4.5",
    "vite":       "^5.2.0"
  }
}
